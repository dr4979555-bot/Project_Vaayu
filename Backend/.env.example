# ==============================================================================
# WeatherGPT Environment Configuration Template
# ==============================================================================

PROJECT_NAME=WeatherGPT
ENVIRONMENT=development

# Database (PostgreSQL with PostGIS extension)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/postgres

# Upstash Redis Cache (Optional - gracefully bypasses if empty)
UPSTASH_REDIS_URL=rediss://default:your_redis_token@your-redis-host.upstash.io:6379

# Groq Cloud API Key & Model for Zero-Hallucination Natural Language Synthesis
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# IMD Authority ECDSA Public Key PEM (Optional - falls back to keys/alert_public.pem)
IMD_PUBLIC_KEY_PEM=

# Allowed CORS Origins (Comma-separated for production frontend deployments)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000
